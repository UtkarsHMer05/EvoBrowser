# ==============================================================================
# EvoBrowser — environment template
# Copy to .env.local and fill in real values:  cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# Clerk — authentication, organizations, and billing
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# ------------------------------------------------------------------------------
# Neon Postgres (Drizzle ORM)
# DATABASE_URL            — pooled connection used by the app at runtime
# DATABASE_URL_UNPOOLED   — direct connection used by drizzle-kit migrations
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/DB?sslmode=require

# ------------------------------------------------------------------------------
# Trigger.dev v4 — durable workflow execution
# ------------------------------------------------------------------------------
TRIGGER_SECRET_KEY=tr_dev_...

# ------------------------------------------------------------------------------
# Liveblocks — realtime multiplayer canvas
# ------------------------------------------------------------------------------
NEXT_PUBLIC_LIVEBLOCKS_PUBLIC_KEY=pk_dev_...
LIVEBLOCKS_SECRET_KEY=sk_...

# ------------------------------------------------------------------------------
# Browserbase — cloud browsers for Stagehand, live view, and session replays
# (secret key; server/worker only — never exposed to the browser)
# ------------------------------------------------------------------------------
BROWSERBASE_API_KEY=...

# ------------------------------------------------------------------------------
# Resend — Send Email node
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_...

# ------------------------------------------------------------------------------
# AI Workflow Planner (Milestones 1–7)
# OpenAI-compatible chat-completions endpoint that returns structured JSON.
# TOKENROUTER_API_KEY   — required for the "Generate Workflow" planner
# TOKENROUTER_BASE_URL  — optional, defaults to https://api.tokenrouter.com/v1
# PLANNER_MODEL         — optional, defaults to deepseek/deepseek-v4-pro-0813-free
# ------------------------------------------------------------------------------
TOKENROUTER_API_KEY=...
# TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
# PLANNER_MODEL=deepseek/deepseek-v4-pro-0813-free

# ------------------------------------------------------------------------------
# Sentry — optional observability
# SENTRY_AUTH_TOKEN is only needed to upload source maps during `npm run build`
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
# SENTRY_AUTH_TOKEN=sntrys_...

# ------------------------------------------------------------------------------
# Phase 2 Evo engine — OPTIONAL, local development only
#
# Only the exact value `evo` selects the C++/Redis/Postgres engine. Unset,
# empty, `legacy`, or any unrecognized value uses Trigger.dev (fail-closed).
# The app and TypeScript worker load .env.local. The C++ scheduler does not,
# so pass EVO_ENGINE_TOKEN and non-default scheduler settings in the shell that
# launches ./engine/build/evo-scheduler-server.
#
# The isolated Redis + PostgreSQL containers are managed by scripts/phase2/*.sh
# (infra/phase2/docker-compose.yml). These local defaults bind to 127.0.0.1.
# The scripts never read DATABASE_URL / DATABASE_URL_UNPOOLED and cannot target
# Neon. The default local password below is not suitable for production.
# ------------------------------------------------------------------------------
# EXECUTION_ENGINE=evo
# EVO_SCHEDULER_ADDR=127.0.0.1:50051
# EVO_ENGINE_TOKEN=replace-with-one-shared-local-secret
# EVO_METRICS_PORT=9090

# EVO_PHASE2_REDIS_HOST=127.0.0.1
# EVO_PHASE2_REDIS_PORT=6390
# EVO_PHASE2_REDIS_PASSWORD=
# EVO_PHASE2_PG_HOST=127.0.0.1
# EVO_PHASE2_PG_PORT=5433
# EVO_PHASE2_PG_USER=evo
# EVO_PHASE2_PG_PASSWORD=evo_dev_password
# EVO_PHASE2_PG_DB=evo_phase2

# EVO_WORKER_ENV_PREFIX=evo:dev
# EVO_WORKER_GROUP=workers
# EVO_WORKER_ID=
# EVO_WORKER_LEASE_DURATION_MS=
# EVO_WORKER_LEASE_RENEW_INTERVAL_MS=
# EVO_WORKER_HEARTBEAT_INTERVAL_MS=

# Optional scheduler admission controls. A zero/unset quota is disabled.
# EVO_QUOTA_MAX_ACTIVE_RUNS_PER_ORG=0
# EVO_QUOTA_MAX_ACTIVE_RUNS_GLOBAL=0
# EVO_QUOTA_MAX_INFLIGHT_TASKS_PER_ORG=0
# EVO_QUOTA_BROWSER_CAPACITY=0
# EVO_QUOTA_EXTERNAL_IO_CAPACITY=0

# Optional weighted least-served-first scheduling.
# EVO_FAIR_SCHEDULING=0
# EVO_ORG_WEIGHTS=org-a:2,org-b:1
# EVO_FAIR_DEMAND_TIMEOUT_MS=5000
